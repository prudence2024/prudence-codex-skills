{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prudence.local/schemas/legal-business-decision.json",
  "title": "Legal Business decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "created_at", "authoring_skill",
    "fact_sheet", "selected_approach", "alternatives", "documents",
    "consistency", "approvals", "risks", "trade_offs",
    "remaining_uncertainties", "validation", "context_changes", "handoffs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "authoring_skill": {"const": "legal-business"},
    "project_revision": {"type": ["string", "null"]},
    "fact_sheet": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fact", "source", "status"],
        "properties": {
          "fact": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "status": {"enum": ["verified", "owner_decision", "assumption", "unresolved", "counsel_dependent"]}
        }
      }
    },
    "selected_approach": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "rationale", "audiences", "jurisdictions"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "audiences": {"$ref": "#/$defs/stringList"},
        "jurisdictions": {"$ref": "#/$defs/stringList"}
      }
    },
    "alternatives": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "rejection_reasons", "trade_offs"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "rejection_reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "trade_offs": {"$ref": "#/$defs/stringList"}
        }
      }
    },
    "documents": {
      "type": "object", "additionalProperties": false,
      "required": ["terms", "privacy", "dpa", "refund", "msa_sla", "cyber_insurance"],
      "properties": {
        "terms": {"$ref": "#/$defs/document"},
        "privacy": {"$ref": "#/$defs/document"},
        "dpa": {"$ref": "#/$defs/document"},
        "refund": {"$ref": "#/$defs/document"},
        "msa_sla": {"$ref": "#/$defs/document"},
        "cyber_insurance": {"$ref": "#/$defs/document"}
      }
    },
    "consistency": {"type": "array", "items": {"$ref": "#/$defs/validation"}},
    "approvals": {
      "type": "object", "additionalProperties": false,
      "required": ["business_owner", "qualified_counsel", "publication"],
      "properties": {
        "business_owner": {"$ref": "#/$defs/approval"},
        "qualified_counsel": {"$ref": "#/$defs/approval"},
        "publication": {"$ref": "#/$defs/approval"}
      }
    },
    "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
    "trade_offs": {"$ref": "#/$defs/stringList"},
    "remaining_uncertainties": {"$ref": "#/$defs/stringList"},
    "validation": {"type": "array", "items": {"$ref": "#/$defs/validation"}},
    "context_changes": {"$ref": "#/$defs/stringList"},
    "handoffs": {"$ref": "#/$defs/stringList"}
  },
  "$defs": {
    "stringList": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["pass", "fail", "partial", "not_applicable", "not_verified"]},
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "version", "facts_used", "unresolved_fields", "review_markers"],
      "properties": {
        "status": {"enum": ["not_required", "draft", "internally_reviewed", "owner_approved", "counsel_reviewed", "approved_for_publication", "published", "superseded"]},
        "version": {"type": "string", "minLength": 1},
        "facts_used": {"$ref": "#/$defs/stringList"},
        "unresolved_fields": {"$ref": "#/$defs/stringList"},
        "review_markers": {"$ref": "#/$defs/stringList"}
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["not_requested", "pending", "approved", "rejected", "not_applicable"]},
        "evidence": {"$ref": "#/$defs/stringList"}
      }
    },
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["description", "severity", "mitigation"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "mitigation": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "status", "evidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "evidence": {"$ref": "#/$defs/stringList"}
      }
    }
  }
}
