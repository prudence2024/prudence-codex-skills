{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prudence.local/schemas/visibility-decision.json",
  "title": "Visibility decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "created_at",
    "authoring_skill",
    "objectives",
    "design_inputs",
    "selected_strategy",
    "alternatives",
    "domains",
    "truth_sources",
    "owner_actions",
    "risks",
    "trade_offs",
    "remaining_uncertainties",
    "validation",
    "context_changes",
    "handoffs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "authoring_skill": {"const": "visibility"},
    "project_revision": {"type": ["string", "null"]},
    "objectives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discoverability", "indexing", "audiences_and_markets", "search_outcomes"],
      "properties": {
        "discoverability": {"$ref": "#/$defs/stringList"},
        "indexing": {"$ref": "#/$defs/stringList"},
        "audiences_and_markets": {"$ref": "#/$defs/stringList"},
        "search_outcomes": {"$ref": "#/$defs/stringList"}
      }
    },
    "design_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_ids", "constraints_consumed", "unresolved_dependencies"],
      "properties": {
        "decision_ids": {"$ref": "#/$defs/stringList"},
        "constraints_consumed": {"$ref": "#/$defs/stringList"},
        "unresolved_dependencies": {"$ref": "#/$defs/stringList"}
      }
    },
    "selected_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "rationale", "existing_capabilities_reused", "new_dependencies"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "existing_capabilities_reused": {"$ref": "#/$defs/stringList"},
        "new_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "justification"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "justification": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "rejection_reasons", "trade_offs"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "rejection_reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "trade_offs": {"$ref": "#/$defs/stringList"}
        }
      }
    },
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seo",
        "discoverability",
        "indexing",
        "structured_data",
        "metadata",
        "social_previews",
        "crawlability",
        "search_performance",
        "web_visibility"
      ],
      "properties": {
        "seo": {"$ref": "#/$defs/domainAssessment"},
        "discoverability": {"$ref": "#/$defs/domainAssessment"},
        "indexing": {"$ref": "#/$defs/domainAssessment"},
        "structured_data": {"$ref": "#/$defs/domainAssessment"},
        "metadata": {"$ref": "#/$defs/domainAssessment"},
        "social_previews": {"$ref": "#/$defs/domainAssessment"},
        "crawlability": {"$ref": "#/$defs/domainAssessment"},
        "search_performance": {"$ref": "#/$defs/domainAssessment"},
        "web_visibility": {"$ref": "#/$defs/domainAssessment"}
      }
    },
    "truth_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact", "source", "drift_control"],
        "properties": {
          "fact": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "drift_control": {"type": "string", "minLength": 1}
        }
      }
    },
    "owner_actions": {"$ref": "#/$defs/stringList"},
    "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
    "trade_offs": {"$ref": "#/$defs/stringList"},
    "remaining_uncertainties": {"$ref": "#/$defs/stringList"},
    "validation": {"type": "array", "items": {"$ref": "#/$defs/validation"}},
    "context_changes": {"$ref": "#/$defs/stringList"},
    "handoffs": {"$ref": "#/$defs/stringList"}
  },
  "$defs": {
    "stringList": {"type": "array", "items": {"type": "string"}},
    "domainAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "actions", "risks"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "evidence": {"$ref": "#/$defs/stringList"},
        "actions": {"$ref": "#/$defs/stringList"},
        "risks": {"$ref": "#/$defs/stringList"}
      }
    },
    "status": {
      "enum": ["pass", "fail", "partial", "not_applicable", "not_verified"]
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "severity", "mitigation"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "mitigation": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "evidence", "environment"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "evidence": {"$ref": "#/$defs/stringList"},
        "environment": {"type": "string", "minLength": 1}
      }
    }
  }
}

