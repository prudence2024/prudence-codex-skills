{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prudence.local/schemas/confidence-config.json",
  "title": "Design confidence configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "formula_version", "scores", "tiers", "calibration_required"],
  "properties": {
    "schema_version": {"const": 1},
    "formula_version": {"type": "string", "minLength": 1},
    "scores": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["established", "contextual", "promising", "experimental", "discouraged"],
      "properties": {
        "established": {"$ref": "#/$defs/tier"},
        "contextual": {"$ref": "#/$defs/tier"},
        "promising": {"$ref": "#/$defs/tier"},
        "experimental": {"$ref": "#/$defs/tier"},
        "discouraged": {"$ref": "#/$defs/tier"}
      }
    },
    "calibration_required": {"type": "boolean"}
  },
  "$defs": {
    "tier": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean"]
      }
    }
  }
}

