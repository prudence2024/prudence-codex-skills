{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prudence.local/schemas/skill-manifest.json",
  "title": "First-party skill manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "category",
    "status",
    "purpose",
    "scope",
    "responsibilities",
    "inputs",
    "outputs",
    "dependencies",
    "configuration",
    "context",
    "pipeline",
    "validation",
    "reporting",
    "extension_points"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "category": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "status": {"enum": ["experimental", "active", "stable", "deprecated"]},
    "purpose": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includes", "excludes"],
      "properties": {
        "includes": {"type": "array", "items": {"type": "string"}},
        "excludes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "responsibilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/interface"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/interface"}},
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {"$ref": "#/$defs/skillIds"},
        "optional": {"$ref": "#/$defs/skillIds"}
      }
    },
    "configuration": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "required"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "default": {}
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reads", "writes"],
      "properties": {
        "reads": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "writes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processing", "reasoning"],
      "properties": {
        "processing": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "reasoning": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "validation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_type"],
      "properties": {
        "report_type": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
      }
    },
    "extension_points": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "skillIds": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "uniqueItems": true
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "description": {"type": "string", "minLength": 1},
        "schema": {"type": "string"}
      }
    }
  }
}

