{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prudence.local/schemas/source-quality-config.json",
  "title": "Design source quality configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dimensions", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "dimensions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["weight"],
        "properties": {
          "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
        }
      }
    },
    "rules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "boolean"}
    }
  }
}

