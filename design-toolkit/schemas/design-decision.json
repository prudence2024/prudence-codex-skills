{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prudence.local/schemas/design-decision.json",
  "title": "Design Toolkit decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "created_at",
    "authoring_skill",
    "objectives",
    "context",
    "selected_solution",
    "alternatives",
    "quality",
    "design_intelligence",
    "risks",
    "trade_offs",
    "remaining_uncertainties",
    "validation",
    "context_changes",
    "handoffs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "authoring_skill": {"const": "design-toolkit"},
    "project_revision": {"type": ["string", "null"]},
    "objectives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business", "user", "conversion"],
      "properties": {
        "business": {"$ref": "#/$defs/stringList"},
        "user": {"$ref": "#/$defs/stringList"},
        "conversion": {"$ref": "#/$defs/stringList"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_identity",
        "product_context",
        "target_audience",
        "technical_constraints"
      ],
      "properties": {
        "brand_identity": {"$ref": "#/$defs/stringList"},
        "product_context": {"$ref": "#/$defs/stringList"},
        "target_audience": {"$ref": "#/$defs/stringList"},
        "technical_constraints": {"$ref": "#/$defs/stringList"}
      }
    },
    "selected_solution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "rationale",
        "reusable_principles",
        "existing_components_reused",
        "new_dependencies"
      ],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "reusable_principles": {"$ref": "#/$defs/stringList"},
        "existing_components_reused": {"$ref": "#/$defs/stringList"},
        "new_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "justification"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "justification": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "rejection_reasons", "trade_offs"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "rejection_reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "trade_offs": {"$ref": "#/$defs/stringList"}
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessibility", "performance", "maintainability", "design_consistency"],
      "properties": {
        "accessibility": {"$ref": "#/$defs/qualityCheck"},
        "performance": {"$ref": "#/$defs/qualityCheck"},
        "maintainability": {"$ref": "#/$defs/qualityCheck"},
        "design_consistency": {"$ref": "#/$defs/qualityCheck"}
      }
    },
    "design_intelligence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queries", "selected_patterns", "rejected_patterns", "knowledge_gaps"],
      "properties": {
        "queries": {"$ref": "#/$defs/stringList"},
        "selected_patterns": {"type": "array", "items": {"$ref": "#/$defs/pattern"}},
        "rejected_patterns": {"type": "array", "items": {"$ref": "#/$defs/pattern"}},
        "knowledge_gaps": {"$ref": "#/$defs/stringList"}
      }
    },
    "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
    "trade_offs": {"$ref": "#/$defs/stringList"},
    "remaining_uncertainties": {"$ref": "#/$defs/stringList"},
    "validation": {"type": "array", "items": {"$ref": "#/$defs/validation"}},
    "context_changes": {"$ref": "#/$defs/stringList"},
    "handoffs": {"$ref": "#/$defs/stringList"},
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module_id", "schema_version", "result"],
        "properties": {
          "module_id": {"type": "string", "minLength": 1},
          "schema_version": {"type": "integer", "minimum": 1},
          "result": {}
        }
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string"}
    },
    "qualityCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "risks"],
      "properties": {
        "status": {
          "enum": ["pass", "fail", "partial", "not_applicable", "not_verified"]
        },
        "evidence": {"$ref": "#/$defs/stringList"},
        "risks": {"$ref": "#/$defs/stringList"}
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "recommendation_score": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "severity", "mitigation"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "mitigation": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "evidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {
          "enum": ["pass", "fail", "partial", "not_applicable", "not_verified"]
        },
        "evidence": {"$ref": "#/$defs/stringList"}
      }
    }
  }
}

