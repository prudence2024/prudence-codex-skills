{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prudence.local/schemas/security-decision.json",
  "title": "Security decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "created_at",
    "authoring_skill",
    "scope",
    "selected_controls",
    "alternatives",
    "domains",
    "risks",
    "trade_offs",
    "remaining_uncertainties",
    "validation",
    "context_changes",
    "handoffs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "authoring_skill": {"const": "security"},
    "project_revision": {"type": ["string", "null"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assets", "actors", "trust_boundaries", "data_classes", "environments"],
      "properties": {
        "assets": {"$ref": "#/$defs/stringList"},
        "actors": {"$ref": "#/$defs/stringList"},
        "trust_boundaries": {"$ref": "#/$defs/stringList"},
        "data_classes": {"$ref": "#/$defs/stringList"},
        "environments": {"$ref": "#/$defs/stringList"}
      }
    },
    "selected_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "rationale", "existing_capabilities_reused", "new_dependencies", "rollback"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "existing_capabilities_reused": {"$ref": "#/$defs/stringList"},
        "new_dependencies": {"$ref": "#/$defs/stringList"},
        "rollback": {"type": "string", "minLength": 1}
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "rejection_reasons", "trade_offs"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "rejection_reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "trade_offs": {"$ref": "#/$defs/stringList"}
        }
      }
    },
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secrets",
        "inputs_outputs",
        "authentication_authorization",
        "data_access",
        "apis_integrations",
        "uploads_payments",
        "infrastructure_delivery",
        "dependencies",
        "resilience_backups",
        "security_observability"
      ],
      "properties": {
        "secrets": {"$ref": "#/$defs/assessment"},
        "inputs_outputs": {"$ref": "#/$defs/assessment"},
        "authentication_authorization": {"$ref": "#/$defs/assessment"},
        "data_access": {"$ref": "#/$defs/assessment"},
        "apis_integrations": {"$ref": "#/$defs/assessment"},
        "uploads_payments": {"$ref": "#/$defs/assessment"},
        "infrastructure_delivery": {"$ref": "#/$defs/assessment"},
        "dependencies": {"$ref": "#/$defs/assessment"},
        "resilience_backups": {"$ref": "#/$defs/assessment"},
        "security_observability": {"$ref": "#/$defs/assessment"}
      }
    },
    "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
    "trade_offs": {"$ref": "#/$defs/stringList"},
    "remaining_uncertainties": {"$ref": "#/$defs/stringList"},
    "validation": {"type": "array", "items": {"$ref": "#/$defs/validation"}},
    "context_changes": {"$ref": "#/$defs/stringList"},
    "handoffs": {"$ref": "#/$defs/stringList"}
  },
  "$defs": {
    "stringList": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["pass", "fail", "partial", "not_applicable", "not_verified"]},
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "actions", "risks"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "evidence": {"$ref": "#/$defs/stringList"},
        "actions": {"$ref": "#/$defs/stringList"},
        "risks": {"$ref": "#/$defs/stringList"}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "severity", "likelihood", "mitigation", "residual_risk"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "likelihood": {"enum": ["unlikely", "possible", "likely", "unknown"]},
        "mitigation": {"type": "string", "minLength": 1},
        "residual_risk": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "evidence", "environment"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "evidence": {"$ref": "#/$defs/stringList"},
        "environment": {"type": "string", "minLength": 1}
      }
    }
  }
}
