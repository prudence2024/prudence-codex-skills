{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prudence.local/schemas/post-production-decision.json",
  "title": "Post Production decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "created_at", "authoring_skill",
    "scope", "deployment_identity", "specialist_runs", "domains", "conflicts",
    "readiness", "findings", "changes", "risks", "trade_offs",
    "remaining_uncertainties", "validation", "context_changes", "handoffs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "authoring_skill": {"const": "post-production"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["request", "project_revision", "environments", "applicable_controls"],
      "properties": {
        "request": {"type": "string", "minLength": 1},
        "project_revision": {"type": ["string", "null"]},
        "environments": {"$ref": "#/$defs/stringList"},
        "applicable_controls": {"$ref": "#/$defs/stringList"}
      }
    },
    "deployment_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "repository_revision", "deployed_revision", "evidence"],
      "properties": {
        "status": {"enum": ["matched", "mismatched", "not_deployed", "not_verified"]},
        "repository_revision": {"type": ["string", "null"]},
        "deployed_revision": {"type": ["string", "null"]},
        "evidence": {"$ref": "#/$defs/stringList"}
      }
    },
    "specialist_runs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["skill_id", "skill_version", "decision_id", "environment", "status", "evidence", "limitations"],
        "properties": {
          "skill_id": {"enum": ["design-toolkit", "visibility", "security", "session-security", "legal-business", "incident-response", "support-triage"]},
          "skill_version": {"type": "string", "minLength": 1},
          "decision_id": {"type": "string", "minLength": 1},
          "environment": {"type": "string", "minLength": 1},
          "status": {"$ref": "#/$defs/status"},
          "evidence": {"$ref": "#/$defs/stringList"},
          "limitations": {"$ref": "#/$defs/stringList"}
        }
      }
    },
    "domains": {
      "type": "object", "additionalProperties": false,
      "required": ["design_quality", "visibility", "security", "sessions", "legal_business", "incident_readiness", "support_readiness", "deployment_code_quality"],
      "properties": {
        "design_quality": {"$ref": "#/$defs/domain"},
        "visibility": {"$ref": "#/$defs/domain"},
        "security": {"$ref": "#/$defs/domain"},
        "sessions": {"$ref": "#/$defs/domain"},
        "legal_business": {"$ref": "#/$defs/domain"},
        "incident_readiness": {"$ref": "#/$defs/domain"},
        "support_readiness": {"$ref": "#/$defs/domain"},
        "deployment_code_quality": {"$ref": "#/$defs/domain"}
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["description", "owners", "resolution", "alternatives", "trade_offs"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "owners": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "resolution": {"type": "string", "minLength": 1},
          "alternatives": {"$ref": "#/$defs/stringList"},
          "trade_offs": {"$ref": "#/$defs/stringList"}
        }
      }
    },
    "readiness": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "score", "formula", "denominator", "limitations"],
      "properties": {
        "status": {"enum": ["scored", "not_enough_evidence"]},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "formula": {"type": "string", "minLength": 1},
        "denominator": {"type": "integer", "minimum": 0},
        "limitations": {"$ref": "#/$defs/stringList"}
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "changes": {"$ref": "#/$defs/stringList"},
    "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
    "trade_offs": {"$ref": "#/$defs/stringList"},
    "remaining_uncertainties": {"$ref": "#/$defs/stringList"},
    "validation": {"type": "array", "items": {"$ref": "#/$defs/validation"}},
    "context_changes": {"$ref": "#/$defs/stringList"},
    "handoffs": {"$ref": "#/$defs/stringList"}
  },
  "$defs": {
    "stringList": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["completed", "partial", "not_started", "not_applicable", "unverified"]},
    "domain": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "status", "evidence", "actions"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "evidence": {"$ref": "#/$defs/stringList"},
        "actions": {"$ref": "#/$defs/stringList"}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["severity", "owner", "finding", "impact", "evidence", "remediation"],
      "properties": {
        "severity": {"enum": ["critical", "high", "medium", "low"]},
        "owner": {"type": "string", "minLength": 1},
        "finding": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/stringList"},
        "remediation": {"type": "string", "minLength": 1}
      }
    },
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["description", "severity", "mitigation"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "mitigation": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "status", "evidence", "environment"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "partial", "not_applicable", "not_verified"]},
        "evidence": {"$ref": "#/$defs/stringList"},
        "environment": {"type": "string", "minLength": 1}
      }
    }
  }
}
